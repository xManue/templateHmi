{
  "id": "operator-shell-main-menu",
  "name": "Operator Shell Main Menu",
  "version": "1.3.0",
  "type": "navigation-popup",
  "description": "Popup di navigazione industriale aperto dalla voce Main dell'Operator Shell.",
  "entry": "src/MainMenuPopupTemplate.jsx",
  "reference": "reference/main-menu-popup.png",
  "relationship": {
    "mode": "linked",
    "parentTemplateId": "operator-shell",
    "trigger": "navigation:main",
    "routes": [
      {
        "itemId": "machine-view",
        "targetPanelId": "can-line-operator",
        "targetPageId": "machine-view"
      },
      {
        "itemId": "counter-machine",
        "targetTemplateId": "machine-counters"
      },
      {
        "itemId": "consumption",
        "targetTemplateId": "consumption"
      }
    ]
  },
  "inputs": {
    "id": "string",
    "items": "Array<{ id, label, icon }>",
    "open": "boolean",
    "anchorY": "number | undefined",
    "onSelect": "(item) => void"
  },
  "editableFiles": [
    "src/templateData.js",
    "src/styles.css"
  ]
}
