{
  "id": "operator-shell",
  "name": "Operator Shell",
  "version": "1.2.0",
  "type": "layout-shell",
  "description": "Guscio HMI con barra superiore, stati macchina, navigazione laterale e area contenuti vuota.",
  "entry": "src/OperatorShellTemplate.jsx",
  "preview": "src/App.jsx",
  "reference": "reference/operator-shell.png",
  "slots": [
    {
      "id": "content",
      "prop": "children",
      "description": "Area centrale destinata alle pagine generate dall'AI."
    }
  ],
  "inputs": {
    "navigationItems": "Array<{ id, label, icon, color }>",
    "machineStates": "Array<{ id, label, warning, safety, mode, state }>",
    "connection": "{ connected, level }",
    "userName": "string",
    "initialSection": "string",
    "onSectionChange": "(sectionId) => void",
    "mainMenuItems": "Array<{ id, label, icon }>",
    "onMainMenuItemSelect": "(itemId) => void",
    "alarmMenuItems": "Array<{ id, label, icon }>",
    "onAlarmMenuItemSelect": "(mode) => void"
  },
  "linkedTemplates": [
    {
      "id": "operator-shell-main-menu",
      "path": "linked/main-menu-popup",
      "trigger": "navigation:main"
    },
    {
      "id": "operator-shell-alarms-menu",
      "path": "linked/alarms-menu-popup",
      "trigger": "navigation:alarms",
      "targetTemplateId": "alarm-list"
    }
  ],
  "editableFiles": [
    "src/templateData.js",
    "src/styles.css",
    "src/App.jsx",
    "linked/main-menu-popup/src/templateData.js",
    "linked/main-menu-popup/src/styles.css",
    "linked/alarms-menu-popup/src/templateData.js",
    "linked/alarms-menu-popup/src/styles.css"
  ]
}
